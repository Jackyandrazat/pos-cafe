{
    "info": {
        "name": "Labo By kodeeweb API v1 (LakuPOS Ecosystem)",
        "_postman_id": "5f76f5df-f51d-4bc7-aadd-31d77b7feb4e",
        "description": "Comprehensive Postman collection for LakuPOS backend API v1 (Laravel 11 + Filament v3), covering Authentication, Store Config & Geofencing, Table Service Calls, Catalogue, Orders, Payments, Webhooks, and Loyalty Program.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
