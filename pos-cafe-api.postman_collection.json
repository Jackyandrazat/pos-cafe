    "item": [
        {
            "name": "Authentication",
            "item": [
                {
                    "name": "Guest Sign-In",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"name\": \"Budi Santoso\",\n    \"phone\": \"081234567890\",\n    \"table_number\": \"{{table_number}}\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": "{{base_url}}/auth/guest",
                        "description": "Creates a temporary guest customer session (4-hour TTL) and returns a Sanctum bearer token."
                    }
                },
                {
                    "name": "Member Sign-In",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"phone\": \"081234567890\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": "{{base_url}}/auth/member",
                        "description": "Logs in an existing cafe member by phone number and returns a Sanctum token with loyalty points and tier level."
                    }
                },
                {
                    "name": "Validate Auth Session",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{auth_token}}"
                            }
                        ],
                        "url": "{{base_url}}/auth/validate",
                        "description": "Validates the current Sanctum bearer token and returns the authenticated user payload."
                    }
                }
            ]
        },
        {
            "name": "Store & Table Management",
            "item": [
                {
                    "name": "Get Store Config & Geofence",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "url": "{{base_url}}/store-config",
                        "description": "Returns store configuration including self-order cashier cash payment permission (`self_order_allow_cash`) and geofence GPS coordinates with radius in meters."
                    }
                },
                {
                    "name": "Get Table Info",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "url": "{{base_url}}/tables/{{table_number}}",
                        "description": "Retrieves table detail (area name, capacity, status) for table QR verification."
                    }
                },
                {
                    "name": "Call Waiter to Table",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"reason\": \"bill\",\n    \"notes\": \"Mohon bawa mesin EDC\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": "{{base_url}}/tables/{{table_number}}/call-waiter",
                        "description": "Sends a waiter assistance notification for the specified table number."
                    }
                },
                {
                    "name": "Cancel Waiter Call",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "url": "{{base_url}}/tables/{{table_number}}/cancel-waiter",
                        "description": "Cancels an active waiter call for the specified table."
                    }
                },
                {
                    "name": "Get Waiter Call Status",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "url": "{{base_url}}/tables/{{table_number}}/call-status",
                        "description": "Checks whether a waiter call is currently pending or responded for the table."
                    }
                }
            ]
