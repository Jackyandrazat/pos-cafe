        {
            "name": "Orders",
            "item": [
                {
                    "name": "List Orders",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{auth_token}}"
                            }
                        ],
                        "url": "{{base_url}}/orders?status=pending&per_page=10",
                        "description": "Lists the authenticated user's orders. Optional query params: `status` (draft|pending|confirmed|preparing|ready|completed|cancelled), `per_page` (1-50)."
                    }
                },
                {
                    "name": "Create Order",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{auth_token}}"
                            },
                            {
                                "key": "X-Idempotency-Key",
                                "value": "{{idempotency_key}}"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"order_type\": \"dine_in\",\n    \"table_id\": {{table_id}},\n    \"table_number\": \"{{table_number}}\",\n    \"customer_name\": \"Budi Santoso\",\n    \"notes\": \"Less sugar, ice dipisah\",\n    \"items\": [\n        {\n            \"menu_id\": {{menu_id}},\n            \"size_id\": 1,\n            \"quantity\": 2,\n            \"toppings\": [1, 2],\n            \"notes\": \"Espresso strong\"\n        }\n    ]\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": "{{base_url}}/orders",
                        "description": "Creates a draft order with items, size modifiers, and toppings. Protected by `X-Idempotency-Key` header."
                    }
                },
                {
                    "name": "Get Order Detail",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{auth_token}}"
                            }
                        ],
                        "url": "{{base_url}}/orders/{{order_id}}",
                        "description": "Returns the specified order with line items, toppings, and price totals."
                    }
                },
                {
                    "name": "Submit Order",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{auth_token}}"
                            }
                        ],
                        "url": "{{base_url}}/orders/{{order_id}}/submit",
                        "description": "Transitions a draft order to pending. Validates stock availability and pushes order to Kitchen Display."
                    }
                },
                {
                    "name": "Cancel Order",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{auth_token}}"
                            }
                        ],
                        "url": "{{base_url}}/orders/{{order_id}}/cancel",
                        "description": "Cancels an order and automatically restores previously deducted ingredient stock."
                    }
                }
            ]
        },
        {
