                            {
                                "key": "Authorization",
                                "value": "Bearer {{auth_token}}"
                            }
                        ],
                        "url": "{{base_url}}/orders/{{order_id}}/qris",
                        "description": "Generates dynamic QRIS string and QR code image payload for the order."
                    }
                },
                {
                    "name": "Get Payment Detail",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
