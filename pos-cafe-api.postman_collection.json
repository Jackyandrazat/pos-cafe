                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"quantity\": 3,\n    \"discount_amount\": 5000,\n    \"notes\": \"Sedang\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": "{{base_url}}/orders/{{order_id}}/items/{{order_item_id}}",
